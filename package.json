    "react-native": "^0.81.5",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2"
  }
}
