{
  "name": "patient-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "web": "node dev-server.js",
    "build:web": "node build-web.js",
    "start": "react-native start",
    "android": "expo run:android",
